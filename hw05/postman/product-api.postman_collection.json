          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products/0/details",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "0",
            "details"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": 1,\n  \"sku\": \"ABC-123-XYZ\",\n  \"manufacturer\": \"Acme Corporation\",\n  \"category_id\": 456,\n  \"weight\": 1250,\n  \"some_other_id\": 789\n}"
        }
      }
    },
    {
      "name": "POST 404 - product not found",
