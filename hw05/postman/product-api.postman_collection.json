          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "99999",
            "details"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": 99999,\n  \"sku\": \"ABC-123-XYZ\",\n  \"manufacturer\": \"Acme Corporation\",\n  \"category_id\": 456,\n  \"weight\": 1250,\n  \"some_other_id\": 789\n}"
        }
      }
    },
